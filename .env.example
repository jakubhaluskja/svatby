# Supabase (Project Settings → API Keys; URL v dialogu Connect)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Doména aplikace; svatby běží na <slug>.<doména>.
# Lokálně: localhost:3000 → svatba na http://jana-a-petr.localhost:3000
NEXT_PUBLIC_APP_DOMAIN=localhost:3000

# E-maily (Resend). Bez klíče se nic neodesílá, aplikace funguje dál.
RESEND_API_KEY=re_...
# Odesílatel z ověřené domény; jméno se nahradí jmény páru.
EMAIL_FROM="Svatby <pozvanky@vase-domena.cz>"
# Podpisový klíč webhooku Resend (stav doručení), endpoint /api/webhooks/resend
RESEND_WEBHOOK_SECRET=whsec_...

# Denní upozornění na úkoly (Vercel Cron posílá Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=nahodny-dlouhy-retezec
